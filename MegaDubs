<!-- =========================================================
     CTA
========================================================= -->

<section class="cta">

    <div class="cta-glow"></div>

    <div class="container cta-content reveal">

        <span class="eyebrow">VAMOS CRIAR ALGO</span>

        <h2>
            A tua história<br>
            <span>merece uma voz.</span>
        </h2>

        <p>
            Tens um projeto que precisa de dobragem, localização
            ou produção de áudio?
        </p>

        <a href="#contacto" class="btn btn-yellow">
            Fala com a MegaDubs
            <span>→</span>
        </a>

    </div>

</section>


<!-- =========================================================
     CONTACTO
========================================================= -->

<section class="section contact" id="contacto">

    <div class="container">

        <div class="contact-grid">


            <div class="contact-info reveal">

                <span class="eyebrow">CONTACTO</span>

                <h2>
                    Vamos dar voz<br>
                    <span>ao teu projeto.</span>
                </h2>

                <p>
                    Se tens uma ideia, um projeto ou simplesmente queres
                    saber mais sobre o nosso trabalho, entra em contacto.
                </p>


                <div class="contact-details">

                    <a href="mailto:contacto@megadubs.pt"
                       class="contact-detail">

                        <span class="contact-icon">✉</span>

                        <div>
                            <small>Email</small>
                            <strong>contacto@megadubs.pt</strong>
                        </div>

                    </a>


                    <a href="#"
                       class="contact-detail">

                        <span class="contact-icon">💬</span>

                        <div>
                            <small>Discord</small>
                            <strong>Comunidade MegaDubs</strong>
                        </div>

                    </a>


                    <a href="#"
                       class="contact-detail">

                        <span class="contact-icon">▶</span>

                        <div>
                            <small>YouTube</small>
                            <strong>MegaDubs</strong>
                        </div>

                    </a>

                </div>

            </div>


            <div class="contact-form-wrapper reveal">

                <form id="contactForm" class="contact-form">

                    <div class="form-row">

                        <div class="form-group">

                            <label for="name">
                                Nome
                            </label>

                            <input
                                type="text"
                                id="name"
                                name="name"
                                placeholder="O teu nome"
                                required
                            >

                        </div>


                        <div class="form-group">

                            <label for="email">
                                Email
                            </label>

                            <input
                                type="email"
                                id="email"
                                name="email"
                                placeholder="o-teu@email.com"
                                required
                            >

                        </div>

                    </div>


                    <div class="form-group">

                        <label for="subject">
                            Assunto
                        </label>

                        <input
                            type="text"
                            id="subject"
                            name="subject"
                            placeholder="Como podemos ajudar?"
                            required
                        >

                    </div>


                    <div class="form-group">

                        <label for="message">
                            Mensagem
                        </label>

                        <textarea
                            id="message"
                            name="message"
                            rows="6"
                            placeholder="Conta-nos um pouco sobre o teu projeto..."
                            required
                        ></textarea>

                    </div>


                    <button type="submit"
                            class="btn btn-primary form-submit">

                        Enviar mensagem
                        <span>→</span>

                    </button>


                    <p class="form-note">
                        Ao enviar, o teu cliente de email será aberto
                        com a mensagem preenchida.
                    </p>

                </form>

            </div>

        </div>

    </div>

</section>


