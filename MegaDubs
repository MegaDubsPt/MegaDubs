<!-- =========================================================
     SOBRE
========================================================= -->

<section class="section about" id="sobre">

    <div class="container">

        <div class="section-heading reveal">

            <span class="eyebrow">QUEM SOMOS</span>

            <h2>
                Mais do que dobragem.<br>
                <span>Uma paixão por dar voz.</span>
            </h2>

            <p>
                A MegaDubs nasceu da paixão pela dobragem, interpretação,
                animação e pelas histórias que nos fazem sentir.
            </p>

        </div>


        <div class="about-grid">

            <div class="about-text reveal">

                <p>
                    Somos uma equipa portuguesa dedicada à produção de
                    conteúdo dobrado e localizado para português europeu.
                </p>

                <p>
                    Reunimos atores de voz, tradutores, adaptadores,
                    editores, técnicos de áudio e criadores para transformar
                    cada projeto numa experiência completa.
                </p>

                <p>
                    O nosso objetivo é simples:
                    <strong>fazer com que cada personagem soe como se
                    sempre tivesse falado português.</strong>
                </p>

                <a href="#servicos" class="text-link">
                    Descobrir os nossos serviços →
                </a>

            </div>


            <div class="about-cards reveal">

                <div class="about-card">
                    <div class="about-icon">🎙</div>
                    <h3>Voz</h3>
                    <p>
                        Interpretação e casting de vozes para personagens
                        únicas e memoráveis.
                    </p>
                </div>

                <div class="about-card">
                    <div class="about-icon">✦</div>
                    <h3>Qualidade</h3>
                    <p>
                        Atenção ao detalhe em cada etapa da produção.
                    </p>
                </div>

                <div class="about-card">
                    <div class="about-icon">🌍</div>
                    <h3>Localização</h3>
                    <p>
                        Conteúdo adaptado ao público português.
                    </p>
                </div>

                <div class="about-card">
                    <div class="about-icon">♥</div>
                    <h3>Paixão</h3>
                    <p>
                        Porque acreditamos que dobrar é contar histórias.
                    </p>
                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     SERVIÇOS
========================================================= -->

<section class="section services" id="servicos">

    <div class="container">

        <div class="section-heading center reveal">

            <span class="eyebrow">O QUE FAZEMOS</span>

            <h2>
                Serviços para dar vida<br>
                <span>a cada projeto.</span>
            </h2>

        </div>


        <div class="services-grid">

            <article class="service-card reveal">

                <div class="service-number">01</div>
                <div class="service-icon">🎙️</div>

                <h3>Dobragem</h3>

                <p>
                    Dobragem de animações, séries, vídeos e outros
                    conteúdos para português europeu.
                </p>

                <span class="service-arrow">↗</span>

            </article>


            <article class="service-card reveal">

                <div class="service-number">02</div>
                <div class="service-icon">✎</div>

                <h3>Tradução & Adaptação</h3>

                <p>
                    Tradução e adaptação de diálogos, mantendo o significado,
                    ritmo e personalidade do conteúdo original.
                </p>

                <span class="service-arrow">↗</span>

            </article>


            <article class="service-card reveal">

                <div class="service-number">03</div>
                <div class="service-icon">🎭</div>

                <h3>Casting</h3>

                <p>
                    Seleção de vozes adequadas para cada personagem,
                    projeto e direção artística.
                </p>

                <span class="service-arrow">↗</span>

            </article>


            <article class="service-card reveal">

                <div class="service-number">04</div>
                <div class="service-icon">🎧</div>

                <h3>Áudio & Mixagem</h3>

                <p>
                    Edição, limpeza, sound design e mistura final para
                    entregar áudio pronto para publicação.
                </p>

                <span class="service-arrow">↗</span>

            </article>


            <article class="service-card reveal">

                <div class="service-number">05</div>
                <div class="service-icon">🎬</div>

                <h3>Direção de Dobragem</h3>

                <p>
                    Direção artística e acompanhamento dos atores durante
                    todo o processo de gravação.
                </p>

                <span class="service-arrow">↗</span>

            </article>


            <article class="service-card reveal">

                <div class="service-number">06</div>
                <div class="service-icon">✨</div>

                <h3>Produção</h3>

                <p>
                    Coordenação completa do projeto, desde o guião até
                    ao master final.
                </p>

                <span class="service-arrow">↗</span>

            </article>

        </div>

    </div>

</section>


<!-- =========================================================
     PROCESSO
========================================================= -->

<section class="section process">

    <div class="container">

        <div class="section-heading center reveal">

            <span class="eyebrow">COMO TRABALHAMOS</span>

            <h2>
                Do guião à voz final.
            </h2>

        </div>


        <div class="process-line">

            <div class="process-item reveal">

                <span class="process-dot">01</span>

                <h3>Briefing</h3>

                <p>
                    Conhecemos o projeto e as suas necessidades.
                </p>

            </div>


            <div class="process-item reveal">

                <span class="process-dot">02</span>

                <h3>Adaptação</h3>

                <p>
                    Tradução e adaptação do conteúdo.
                </p>

            </div>


            <div class="process-item reveal">

                <span class="process-dot">03</span>

                <h3>Casting</h3>

                <p>
                    Encontramos as vozes certas.
                </p>

            </div>


            <div class="process-item reveal">

                <span class="process-dot">04</span>

                <h3>Gravação</h3>

                <p>
                    Os atores dão vida às personagens.
                </p>

            </div>


            <div class="process-item reveal">

                <span class="process-dot">05</span>

                <h3>Finalização</h3>

                <p>
                    Edição, mistura e controlo de qualidade.
                </p>

            </div>

        </div>

    </div>

</section>


